# Tesla Battery MCP — do not commit a populated copy of this file.
# Tesla uses a Developer Client ID and Client Secret, not a standalone API key.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Select exactly one credential path:
# 1) Use `pnpm oauth` after building. It stores rotated tokens in TESLA_TOKEN_CACHE_FILE.
# 2) Or set a current refresh token directly (it is single-use and rotates on use).
# TESLA_REFRESH_TOKEN=
# 3) Or set a short-lived access token for one process only.
# TESLA_ACCESS_TOKEN=

# North America and Asia-Pacific (except China). Alternatives:
# https://fleet-api.prd.eu.vn.cloud.tesla.com (Europe, Middle East, Africa)
# https://fleet-api.prd.cn.vn.cloud.tesla.cn (China; separate local account/application required)
TESLA_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com

# Required for `pnpm oauth`. Register this exact callback in the Tesla developer app.
TESLA_REDIRECT_URI=http://127.0.0.1:43189/callback

# Recommended private location for the rotating refresh-token cache.
TESLA_TOKEN_CACHE_FILE=~/.config/tesla-battery-mcp/token-cache.json

# Optional. Restrict all live API calls to listed VINs, comma-separated.
# TESLA_VIN_ALLOWLIST=

# Optional. Path to decoded Tesla Fleet Telemetry JSON Lines retained locally.
# This is required for brick/module extrema and historical tools.
# TESLA_TELEMETRY_FILE=~/.local/share/tesla-battery-mcp/fleet-telemetry.jsonl

# Optional direct-BMS evidence shown in the local dashboard. Set only one.
# TESLA_SCANMYTESLA_EXPORT_FILE=~/Downloads/scanmytesla-export.csv
# TESLA_TESLALOGGER_EXPORT_FILE=~/.local/share/tesla-battery-mcp/teslalogger-diagnostics.json
# Optional on-demand direct ELM/STN capture whenever the dashboard refreshes.
# Do not set while Scan My Tesla is connected to the same Bluetooth Classic adapter.
# TESLA_DIRECT_CAN_PORT=COM3
# TESLA_DIRECT_CAN_BAUD=38400
# TESLA_DIRECT_CAN_SECONDS=8
# battery (default) or extended. Extended also decodes 10 more Scan My Tesla-style messages
# (pack V/I, BMS limits and thermal, lifetime kWh, DC-DC, charge line, rear inverter) and adds about 15 s.
# TESLA_DIRECT_CAN_PROFILE=battery

# Local dashboard. It deliberately binds to the loopback interface only.
TESLA_DASHBOARD_HOST=127.0.0.1
TESLA_DASHBOARD_PORT=4760
# Generate a high-entropy value locally, for example: openssl rand -hex 32
TESLA_DASHBOARD_TOKEN=

# Loopback Streamable HTTP MCP companion. This is optional; Claude Desktop and
# Gemini CLI can use the stdio launcher directly. Do not expose this port to
# the public internet. Use OpenAI Secure MCP Tunnel for ChatGPT remote access.
TESLA_HTTP_MCP_HOST=127.0.0.1
TESLA_HTTP_MCP_PORT=4761
TESLA_HTTP_MCP_TOKEN=

# Default is 20 seconds. Tesla live `vehicle_data` reads are never background-polled by this MCP.
TESLA_REQUEST_TIMEOUT_MS=20000

# telemetry.sh: SSH target and public hostname of your Fleet Telemetry server.
# TESLA_TELEMETRY_VPS=ubuntu@your-vps
# TESLA_TELEMETRY_HOSTNAME=telemetry.example.com
